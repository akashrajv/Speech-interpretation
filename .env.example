# Counterpoint AI Environment Configuration

# Application
APP_ENV=development
APP_PORT=8000
FRONTEND_PORT=5173
DEBUG=true

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_GEMINI=false

# Database
DATABASE_URL=sqlite:///./counterpoint.db

# Storage
AUDIO_STORAGE_DIR=./data/raw
PROCESSED_STORAGE_DIR=./data/processed
MAX_UPLOAD_SIZE_MB=50
MAX_AUDIO_DURATION_SECONDS=600

# Scoring Rubric Weights (Must sum to 1.0)
WEIGHT_PACING=0.25
WEIGHT_PITCH=0.20
WEIGHT_VOLUME=0.20
WEIGHT_PRONUNCIATION=0.20
WEIGHT_EMPHASIS=0.15
